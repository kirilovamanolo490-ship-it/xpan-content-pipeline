# Copy to .env. Real credentials and destinations are never committed.
XPAN_FEISHU_SOURCE_URL=
XPAN_X_PROFILE_URL=https://example.invalid/x/profile
XPAN_TELEGRAM_CHANNEL_URL=https://example.invalid/telegram/channel
# Confirm the account through Typefully MCP before filling this value.
XPAN_TYPEFULLY_SOCIAL_SET_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
